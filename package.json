{
    "devDependencies": {
        "elm": "0.19.1-6",
        "elm-codegen": "^0.6.3",
        "elm-format": "^0.8.8",
        "elm-review": "^2.13.5",
        "elm-test-rs": "^3.2.0-0",
        "elm-watch": "^2.0.0-beta.14",
        "lamdera": "^0.19.1-1.4.0",
        "netlify-cli": "^27.4.0",
        "run-pty": "^6.0.2"
    },
    "scripts": {
        "start": "run-pty % bun run build:watch % bun run elm-watch:hot",
        "elm-watch:hot": "elm-watch hot",
        "build:watch": "watchexec -c --ignore-nothing -o signal -w media -w DLCs -w script/src 'cd script; bun start; touch ../src/Main.elm'",
        "build": "make build",
        "test": "make test"
    },
    "name": "witch-awakening",
